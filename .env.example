# ANDALUS CINEMA LAB — Variables de entorno del SERVIDOR
# Copia este archivo como .env en la raíz del proyecto

# ═══════════════════════════════════════════════════════════
# OBLIGATORIAS
# ═══════════════════════════════════════════════════════════

# Google Gemini API Key (SOLO en el servidor, NUNCA en frontend)
# Obtener en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ═══════════════════════════════════════════════════════════
# MODELOS
# ═══════════════════════════════════════════════════════════

# Modelo de texto para adaptación literaria
TEXT_MODEL=gemini-2.0-flash

# Modelo de vídeo para generación cinematográfica
VIDEO_MODEL=veo-2.0-generate-001

# ═══════════════════════════════════════════════════════════
# SEGURIDAD
# ═══════════════════════════════════════════════════════════

# Secreto para firmar cookies de sesión (cambiar por string aleatorio)
SESSION_SECRET=cambiar-por-string-aleatorio-seguro-de-32-caracteres

# ═══════════════════════════════════════════════════════════
# ALMACENAMIENTO
# ═══════════════════════════════════════════════════════════

# Directorio de datos persistentes (PDFs, vídeos, SQLite)
DATA_DIR=./data

# ═══════════════════════════════════════════════════════════
# SERVIDOR
# ═══════════════════════════════════════════════════════════

# Puerto del servidor backend
PORT=3000

# Origen permitido para CORS (frontend)
APP_ORIGIN=http://localhost:5173

# Tamaño máximo de subida en MB
MAX_UPLOAD_MB=50

# Entorno (production habilita cookies secure)
NODE_ENV=development
