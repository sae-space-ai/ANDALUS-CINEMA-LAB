# ANDALUS CINEMA LAB — Variables de entorno
# Copia este archivo como .env y rellena los valores

# Google Gemini API Key (obligatoria para IA)
# Obtener en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de texto para adaptación literaria
TEXT_MODEL=gemini-2.0-flash

# Modelo de vídeo para generación cinematográfica
VIDEO_MODEL=veo-2.0-generate-001

# Contraseña del propietario (hash)
# En frontend se usa localStorage; en backend sería hash bcrypt
OWNER_PASSWORD_HASH=

# Secreto de sesión (para backend)
SESSION_SECRET=change-me-to-random-string

# Directorio de datos persistentes
DATA_DIR=./data

# Origen de la aplicación
APP_ORIGIN=http://localhost:5173

# Tamaño máximo de subida en MB
MAX_UPLOAD_MB=50

# Límite de gasto máximo por operación (USD)
MAX_GENERATION_COST=5.00

# Puerto del servidor
PORT=3000
