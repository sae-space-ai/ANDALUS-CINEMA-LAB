# ANDALUS CINEMA LAB — Variables de entorno para producción
# IMPORTANTE: Configurar estas variables en el panel del servicio de despliegue

# OBLIGATORIA para funciones de IA
GEMINI_API_KEY=

# OBLIGATORIA para seguridad de sesiones
SESSION_SECRET=

# Opcional: Modelo de texto (default: gemini-2.0-flash)
TEXT_MODEL=gemini-2.0-flash

# Opcional: Modelo de vídeo (default: veo-2.0-generate-001)
VIDEO_MODEL=veo-2.0-generate-001

# Opcional: Puerto (default: 3000)
PORT=3000

# Opcional: Directorio de datos (default: ./data)
DATA_DIR=./data

# Opcional: Tamaño máximo de subida en MB (default: 50)
MAX_UPLOAD_MB=50

# Opcional: Origen CORS (ajustar según dominio de producción)
APP_ORIGIN=https://tu-dominio.com

# Producción
NODE_ENV=production
